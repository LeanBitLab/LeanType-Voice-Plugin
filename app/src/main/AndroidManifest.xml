<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <permission
        android:name="com.leanbitlab.leantype.permission.BIND_VOICE_PLUGIN"
        android:protectionLevel="signature" />

    <queries>
        <package android:name="com.leanbitlab.leantype" />
        <package android:name="com.leanbitlab.leantype.debug" />
    </queries>

    <application
        android:allowBackup="false"
        android:label="LeanType Voice Plugin">

        <service
            android:name=".VoiceEngineService"
            android:exported="true"
            android:permission="com.leanbitlab.leantype.permission.BIND_VOICE_PLUGIN">
            <intent-filter>
                <action android:name="com.leanbitlab.leantype.voice.offline.ENGINE" />
            </intent-filter>
        </service>
    </application>
</manifest>
